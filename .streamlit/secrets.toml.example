# Copy to .streamlit/secrets.toml locally, or paste these values into
# Streamlit Community Cloud's Advanced settings > Secrets field.
# Never commit the real secrets.toml file.

LLM_PROVIDER = "openai"
OPENAI_API_KEY = "replace-with-your-openai-api-key"
OPENAI_MODEL = "gpt-4o-mini"
LLM_TEMPERATURE = "0.1"
LLM_TIMEOUT_SECONDS = "20"
RAG_TOP_K = "3"
RAG_MIN_SCORE = "1.5"
SIMULATE_API_FAILURE = "false"
